<Project Sdk="Microsoft.NET.Sdk">
  <!-- net48 a propósito: CodeWalker.Core usa .NET Framework 4.8 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>ClothPreview</RootNamespace>
    <AssemblyName>ClothPreview</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Evita que el código de CodeWalker se compile dentro de este proyecto -->
  <ItemGroup>
    <Compile Remove="libs\**" />
    <EmbeddedResource Remove="libs\**" />
    <None Remove="libs\**" />
    <Page Remove="libs\**" />
    <ApplicationDefinition Remove="libs\**" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HelixToolkit.Wpf" Version="2.25.0" />
    <PackageReference Include="Pfim" Version="0.11.3" />
    <ProjectReference Include="libs\CodeWalker\CodeWalker.Core\CodeWalker.Core.csproj" />
  </ItemGroup>
</Project>
