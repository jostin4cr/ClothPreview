<Window x:Class="ClothPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="420 Tool´s · Cloth Preview 3D" Width="1240" Height="780" MinWidth="960" MinHeight="660"
        Icon="Assets/icon.png" Background="#050506" AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#050506" />
    <SolidColorBrush x:Key="Panel" Color="#0E0E11" />
    <SolidColorBrush x:Key="Panel2" Color="#1A1A1F" />
    <SolidColorBrush x:Key="Line" Color="#2A2A31" />
    <SolidColorBrush x:Key="Red" Color="#E50914" />
    <SolidColorBrush x:Key="RedDark" Color="#7A0509" />
    <SolidColorBrush x:Key="Txt" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Muted" Color="#8C8C96" />

    <!-- Trama de puntos (semitono) como en la ilustración -->
    <ImageBrush x:Key="HalftoneBrush" ImageSource="Assets/halftone.png" TileMode="Tile"
                ViewportUnits="Absolute" Viewport="0,0,8,8" Opacity="0.10" />

    <LinearGradientBrush x:Key="PanelBg" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#15151A" Offset="0" />
      <GradientStop Color="#08080A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BtnBg" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#26262D" Offset="0" />
      <GradientStop Color="#141417" Offset="1" />
    </LinearGradientBrush>

    <!-- Botón con borde de neón rojo -->
    <Style x:Key="RedButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{StaticResource BtnBg}" BorderBrush="{StaticResource Red}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect Color="#E50914" BlurRadius="8" ShadowDepth="0" Opacity="0.35" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="White" />
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#E50914" BlurRadius="18" ShadowDepth="0" Opacity="0.85" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource RedDark}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="Margin" Value="0,4,0,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="3" BorderThickness="1.5"
                      BorderBrush="{StaticResource Red}" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2"
                      Stretch="Uniform" Margin="2" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Red}" />
                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botones segmentados -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="{StaticResource BtnBg}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" Padding="4,7" Margin="0,0,4,0" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Red}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Filas de la lista de prendas -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0"
                    Padding="10,6" Margin="0,1,0,1" CornerRadius="0,6,6,0">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1F1F25" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#34090D" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Red}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Chips (variaciones de textura) -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Red}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Barra de desplazamiento -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{StaticResource RedDark}" CornerRadius="4" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Deslizador -->
    <Style TargetType="Slider">
      <Setter Property="Height" Value="20" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="{StaticResource Line}" VerticalAlignment="Center" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="14" Height="14">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{StaticResource Red}" Stroke="White" StrokeThickness="1" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Encabezados de sección: un halo (como los de los angelitos) + título -->
    <Style x:Key="SectionBar" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,0,0,5" />
      <Setter Property="Margin" Value="0,16,0,8" />
      <Setter Property="Background">
        <Setter.Value>
          <DrawingBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                  <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,18,12" />
                  </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                  <GeometryDrawing.Pen>
                    <Pen Brush="#99E50914" Thickness="3.2" />
                  </GeometryDrawing.Pen>
                  <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="9,6" RadiusX="7" RadiusY="2.8" />
                  </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                  <GeometryDrawing.Pen>
                    <Pen Brush="White" Thickness="1.2" />
                  </GeometryDrawing.Pen>
                  <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="9,6" RadiusX="7" RadiusY="2.8" />
                  </GeometryDrawing.Geometry>
                </GeometryDrawing>
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F2" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="26,0,0,0" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===================== PANEL IZQUIERDO ===================== -->
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Textura de puntos y resplandor rojo de fondo -->
        <Rectangle Grid.RowSpan="2" Fill="{StaticResource HalftoneBrush}" IsHitTestVisible="False" />
        <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.5,1.05" GradientOrigin="0.5,1.05" RadiusX="0.9" RadiusY="0.45">
              <GradientStop Color="#40E50914" Offset="0" />
              <GradientStop Color="#00E50914" Offset="1" />
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <!-- Cabecera con la ilustración (animada) -->
        <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource Red}" BorderThickness="0,0,0,2">
          <Grid>
            <Rectangle Fill="{StaticResource HalftoneBrush}" />
            <StackPanel Margin="0,12,0,12">
              <Grid Margin="18,0,18,0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1" />
                </Grid.RenderTransform>
                <Image Source="Assets/header_art.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.Effect>
                    <DropShadowEffect x:Name="LogoGlow" Color="#E50914" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                  </Image.Effect>
                </Image>
                <!-- Destello que recorre la ilustración -->
                <Rectangle IsHitTestVisible="False">
                  <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="Assets/header_art.png" Stretch="Uniform" />
                  </Rectangle.OpacityMask>
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                      <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform x:Name="LogoShine" X="-1.3" />
                      </LinearGradientBrush.RelativeTransform>
                      <GradientStop Color="#00FFFFFF" Offset="0.38" />
                      <GradientStop Color="#B0FFFFFF" Offset="0.5" />
                      <GradientStop Color="#00FFFFFF" Offset="0.62" />
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
              </Grid>
              <Grid Margin="20,6,20,0">
                <TextBlock FontFamily="Bahnschrift, Segoe UI" FontSize="23" FontWeight="Bold" VerticalAlignment="Center">
                  <Run Text="420" Foreground="{StaticResource Red}" FontWeight="Black" /><Run Text=" Tool´s" Foreground="White" />
                </TextBlock>
                <TextBlock Text="CLOTH PREVIEW 3D" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="10" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
              </Grid>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Contenido con scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,6,16,16">
            <Button Style="{StaticResource RedButton}" Margin="0,12,0,0" Content="ABRIR ARCHIVOS (.ydd / .ytd)" Click="Open_Click" />
            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="…o arrastra una carpeta o los archivos de tu pack. Cada vez que arrastres, se añaden a la lista." />

            <Border Style="{StaticResource SectionBar}">
              <Grid>
                <TextBlock Style="{StaticResource SectionTitle}" Text="PRENDAS" VerticalAlignment="Bottom" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Style="{StaticResource RedButton}" Content="QUITAR" Padding="8,2" FontSize="10" Margin="0,0,6,0" Click="Clear_Click" />
                  <Button Style="{StaticResource RedButton}" Content="VACIAR" Padding="8,2" FontSize="10" Click="Empty_Click" />
                </StackPanel>
              </Grid>
            </Border>
            <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" MaxHeight="230" SelectionMode="Multiple"
                     ItemContainerStyle="{StaticResource RowItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ItemList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" Foreground="{StaticResource Txt}" />
                      <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding GenderGlyph}" Foreground="White"
                               FontSize="16" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Style="{StaticResource SectionBar}">
              <TextBlock Style="{StaticResource SectionTitle}" Text="TEXTURA" />
            </Border>
            <ListBox x:Name="VariantBox" Background="Transparent" BorderThickness="0" DisplayMemberPath="Label"
                     ItemContainerStyle="{StaticResource ChipItem}" MaxHeight="96"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="VariantBox_SelectionChanged">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>

            <Border Style="{StaticResource SectionBar}">
              <TextBlock Style="{StaticResource SectionTitle}" Text="PERSONAJE" />
            </Border>
            <UniformGrid Columns="3">
              <RadioButton x:Name="GenAuto" Style="{StaticResource Seg}" GroupName="g" Content="AUTO" IsChecked="True" Checked="Gender_Changed" />
              <RadioButton x:Name="GenMale" Style="{StaticResource Seg}" GroupName="g" Content="HOMBRE" Checked="Gender_Changed" />
              <RadioButton x:Name="GenFemale" Style="{StaticResource Seg}" GroupName="g" Content="MUJER" Checked="Gender_Changed" />
            </UniformGrid>

            <Border Style="{StaticResource SectionBar}">
              <TextBlock Style="{StaticResource SectionTitle}" Text="PARTES DE LA PRENDA" />
            </Border>
            <ItemsControl x:Name="PartList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible, Mode=OneWay}"
                            Margin="0,0,14,4" Checked="Part_Toggled" Unchecked="Part_Toggled" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="PropPanel" Visibility="Collapsed">
              <Border Style="{StaticResource SectionBar}">
                <TextBlock Style="{StaticResource SectionTitle}" Text="AJUSTE DEL ACCESORIO" />
              </Border>
              <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="X" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Slider x:Name="OffXSlider" Grid.Column="1" Minimum="-0.6" Maximum="0.6" ValueChanged="Prop_Changed" />
              </Grid>
              <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Y" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Slider x:Name="OffYSlider" Grid.Column="1" Minimum="-0.6" Maximum="0.6" ValueChanged="Prop_Changed" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Z" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <Slider x:Name="OffZSlider" Grid.Column="1" Minimum="-0.6" Maximum="0.6" ValueChanged="Prop_Changed" />
              </Grid>
            </StackPanel>

            <Border Style="{StaticResource SectionBar}">
              <TextBlock Style="{StaticResource SectionTitle}" Text="VISTA" />
            </Border>
            <CheckBox x:Name="ShowBody" Content="Mostrar cuerpo" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
            <CheckBox x:Name="ShowTexture" Content="Mostrar textura" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
            <CheckBox x:Name="WireBox" Content="Mostrar malla (wireframe)" Checked="Option_Changed" Unchecked="Option_Changed" />
            <CheckBox x:Name="SpinBox" Content="Girar automáticamente" Checked="Spin_Changed" Unchecked="Spin_Changed" />

            <Button x:Name="ImportButton" Style="{StaticResource RedButton}" Margin="0,16,0,0"
                    Content="IMPORTAR CUERPO DESDE GTA V" Click="ImportBody_Click" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ===================== VISOR 3D ===================== -->
    <Grid x:Name="ViewportArea" Grid.Column="1" ClipToBounds="True">

      <!-- Fondo de estudio -->
      <Rectangle x:Name="BackdropFill" />
      <Rectangle Fill="{StaticResource HalftoneBrush}" IsHitTestVisible="False" />
      <Rectangle x:Name="Vignette" IsHitTestVisible="False">
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
            <GradientStop Color="#00000000" Offset="0.55" />
            <GradientStop Color="#B3000000" Offset="1" />
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <!-- Marca de agua: la ilustración + 420 DESIGNS -->
      <Viewbox Stretch="Uniform" Margin="50,40,50,120" IsHitTestVisible="False">
        <StackPanel>
          <Grid>
            <Image x:Name="WmArt" Source="Assets/wm_art.png" Width="1100" Stretch="Uniform" Opacity="0.34"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="WmBig" Text="420" Visibility="Collapsed" HorizontalAlignment="Center"
                       FontFamily="Bahnschrift, Segoe UI" FontWeight="Black" FontSize="420" Foreground="#26E50914" />
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Rectangle Width="120" Height="6" Fill="{StaticResource Red}" VerticalAlignment="Center" Margin="0,0,30,0" />
            <TextBlock x:Name="WmSmall" Text="D E S I G N S" FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold"
                       FontSize="80" Foreground="#66FFFFFF" />
            <Rectangle Width="120" Height="6" Fill="{StaticResource Red}" VerticalAlignment="Center" Margin="30,0,0,0" />
          </StackPanel>
        </StackPanel>
      </Viewbox>

      <!-- Sello en la esquina -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,18,14" IsHitTestVisible="False">
        <Image x:Name="CornerLogo" Source="Assets/logo420.png" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock x:Name="Corner420" Text="420" Visibility="Collapsed" FontFamily="Bahnschrift, Segoe UI" FontSize="16"
                   FontWeight="Black" Foreground="{StaticResource Red}" VerticalAlignment="Center" />
        <TextBlock x:Name="CornerRun" Text=" DESIGNS" FontFamily="Bahnschrift, Segoe UI" FontSize="15" FontWeight="Bold"
                   Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>

      <!-- Modelo 3D (fondo transparente para ver el estudio detrás) -->
      <helix:HelixViewport3D x:Name="Viewport" Background="Transparent" ModelUpDirection="0,0,1"
                             ShowCoordinateSystem="False" ShowViewCube="False">
        <helix:DefaultLights />
        <ModelVisual3D>
          <ModelVisual3D.Content>
            <Model3DGroup>
              <AmbientLight Color="#383838" />
              <DirectionalLight Color="#8A1218" Direction="1,-1,-0.3" />
              <DirectionalLight Color="#444444" Direction="-1,1,-0.5" />
            </Model3DGroup>
          </ModelVisual3D.Content>
        </ModelVisual3D>
        <ModelVisual3D x:Name="ModelHost" />
        <helix:LinesVisual3D x:Name="Wire" Color="#FF2A2A" Thickness="0.6" />
      </helix:HelixViewport3D>

      <!-- Interfaz (se oculta al tomar la foto) -->
      <Grid x:Name="HudLayer">
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="14,7"
                Background="#E6000000" BorderBrush="#B3FFFFFF" BorderThickness="1" CornerRadius="4">
          <Border.Effect>
            <DropShadowEffect Color="#E50914" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
          </Border.Effect>
          <StackPanel Orientation="Horizontal">
            <Image Source="Assets/logo420.png" Height="18" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="ItemTitle" Text="SIN PRENDA" Foreground="White" FontWeight="Bold"
                       FontFamily="Bahnschrift, Segoe UI" FontSize="16" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Barra de fondo y fotos -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="8"
                Background="#E6000000" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8">
          <Border.Effect>
            <DropShadowEffect Color="#E50914" BlurRadius="14" ShadowDepth="0" Opacity="0.35" />
          </Border.Effect>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="FONDO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="4,0,8,0" />
            <UniformGrid Columns="3" Width="190">
              <RadioButton x:Name="BgRed" Style="{StaticResource Seg}" GroupName="bg" Content="ROJO" IsChecked="True" Checked="Backdrop_Changed" />
              <RadioButton x:Name="BgBlack" Style="{StaticResource Seg}" GroupName="bg" Content="NEGRO" Checked="Backdrop_Changed" />
              <RadioButton x:Name="BgWhite" Style="{StaticResource Seg}" GroupName="bg" Content="BLANCO" Checked="Backdrop_Changed" />
            </UniformGrid>
            <Button Style="{StaticResource RedButton}" Content="ENCUADRAR" Padding="10,6" FontSize="11" Margin="8,0,0,0" Click="Frame_Click" />
            <Button Style="{StaticResource RedButton}" Content="FOTO" Padding="12,6" FontSize="11" Margin="6,0,0,0" Click="Photo_Click" />
            <Button Style="{StaticResource RedButton}" Content="COPIAR" Padding="10,6" FontSize="11" Margin="6,0,0,0" Click="Copy_Click" />
          </StackPanel>
        </Border>

        <!-- Datos -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                Background="#E6000000" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="6">
          <Grid>
            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource Red}" />
            <TextBlock x:Name="Info" Foreground="{StaticResource Txt}" FontFamily="Consolas" FontSize="12"
                       TextWrapping="Wrap" MaxWidth="440" Margin="16,10,14,10" />
          </Grid>
        </Border>

        <Border x:Name="BodyOverlay" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="16,16,16,50" Padding="14" MaxWidth="300" Background="#EB000000"
                BorderBrush="#B3FFFFFF" BorderThickness="1" CornerRadius="8">
          <Border.Effect>
            <DropShadowEffect Color="#E50914" BlurRadius="18" ShadowDepth="0" Opacity="0.6" />
          </Border.Effect>
          <StackPanel>
            <TextBlock Text="PERSONAJE NO IMPORTADO" Foreground="{StaticResource Red}" FontWeight="Bold" />
            <TextBlock Margin="0,6,0,10" Foreground="{StaticResource Txt}" TextWrapping="Wrap" FontSize="12"
                       Text="Para ver la prenda puesta en un hombre o una mujer, importa el cuerpo desde tu GTA V. Se hace una sola vez." />
            <Button Style="{StaticResource RedButton}" Content="IMPORTAR AHORA" Click="ImportBody_Click" />
          </StackPanel>
        </Border>

        <TextBlock x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Foreground="#80FFFFFF" FontFamily="Bahnschrift, Segoe UI" FontSize="22" IsHitTestVisible="False"
                   Text="ARRASTRA TU PACK AQUÍ&#x0a;.ydd + .ytd" />
      </Grid>
    </Grid>
  </Grid>
</Window>
