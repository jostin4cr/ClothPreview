<Window x:Class="ClothPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="Cloth Preview 3D" Width="1100" Height="700"
        AllowDrop="True" Drop="Window_Drop">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Margin="8">
      <Button DockPanel.Dock="Top" Content="Abrir archivos (.ydd / .ytd)…" Padding="6" Click="Open_Click" />
      <TextBlock DockPanel.Dock="Top" Margin="0,6,0,8" Foreground="Gray" TextWrapping="Wrap"
                 Text="…o arrastra aquí una carpeta o los archivos de tu pack." />
      <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <TextBlock Text="Variación de textura" />
        <ComboBox x:Name="VariantBox" DisplayMemberPath="Label" Margin="0,2,0,8"
                  SelectionChanged="VariantBox_SelectionChanged" />
        <TextBlock Text="Personaje" />
        <ComboBox x:Name="GenderBox" SelectedIndex="0" Margin="0,2,0,8" SelectionChanged="Gender_Changed">
          <ComboBoxItem Content="Automático (según la prenda)" />
          <ComboBoxItem Content="Hombre" />
          <ComboBoxItem Content="Mujer" />
        </ComboBox>
        <CheckBox x:Name="ShowBody" Content="Mostrar cuerpo" IsChecked="True"
                  Checked="Option_Changed" Unchecked="Option_Changed" />
        <CheckBox x:Name="ShowTexture" Content="Mostrar textura" IsChecked="True" Margin="0,4,0,0"
                  Checked="Option_Changed" Unchecked="Option_Changed" />
        <CheckBox x:Name="WireBox" Content="Mostrar malla (wireframe)" Margin="0,4,0,0"
                  Checked="Option_Changed" Unchecked="Option_Changed" />
        <Button x:Name="ImportButton" Content="Importar cuerpo desde GTA V…" Margin="0,10,0,0" Padding="4"
                Click="ImportBody_Click" />
        <TextBlock x:Name="Info" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="DimGray" />
      </StackPanel>
      <ListBox x:Name="ItemList" DisplayMemberPath="Display" SelectionChanged="ItemList_SelectionChanged" />
    </DockPanel>

    <helix:HelixViewport3D x:Name="Viewport" Grid.Column="1" ModelUpDirection="0,0,1"
                           ShowCoordinateSystem="True" Background="#FF2B2B2B">
      <helix:DefaultLights />
      <ModelVisual3D x:Name="ModelHost" />
      <helix:LinesVisual3D x:Name="Wire" Color="Black" Thickness="0.6" />
    </helix:HelixViewport3D>
  </Grid>
</Window>
