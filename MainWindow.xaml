<Window x:Class="ClothPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="420 Tool´s · Cloth Preview 3D" Width="1200" Height="760" MinWidth="900" MinHeight="660"
        Background="#0A0A0C" AllowDrop="True" Drop="Window_Drop">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0A0A0C" />
    <SolidColorBrush x:Key="Panel" Color="#121215" />
    <SolidColorBrush x:Key="Panel2" Color="#1A1A1F" />
    <SolidColorBrush x:Key="Line" Color="#2A2A31" />
    <SolidColorBrush x:Key="Red" Color="#E50914" />
    <SolidColorBrush x:Key="RedDark" Color="#7A0509" />
    <SolidColorBrush x:Key="Txt" Color="#EDEDED" />
    <SolidColorBrush x:Key="Muted" Color="#8C8C96" />

    <!-- Botón -->
    <Style x:Key="RedButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Red}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource RedDark}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="Margin" Value="0,4,0,4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="3" BorderThickness="1.5"
                      BorderBrush="{StaticResource Red}" Background="Transparent" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2"
                      Stretch="Uniform" Margin="2" Visibility="Collapsed" />
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Red}" />
                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botones segmentados (personaje) -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" Padding="4,7" Margin="0,0,4,0" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Red}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Red}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Filas de la lista de prendas -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0"
                    Padding="10,7" Margin="0,1,0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1F1F25" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2A0A0C" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Red}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Chips (variaciones de textura) -->
    <Style x:Key="ChipItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Txt}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Red}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Red}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Red}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Barra de desplazamiento -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{StaticResource RedDark}" CornerRadius="4" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Red}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== PANEL IZQUIERDO ===== -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Border Grid.Row="0" Background="Black" Padding="16,14" BorderBrush="{StaticResource Red}" BorderThickness="0,0,0,2">
          <StackPanel Orientation="Horizontal">
            <Border Background="{StaticResource Red}" CornerRadius="8" Padding="10,0,10,2" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <SkewTransform AngleX="-8" />
              </Border.RenderTransform>
              <TextBlock Text="420" FontFamily="Bahnschrift, Segoe UI" FontWeight="Black" FontSize="32" Foreground="White" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Tool´s" FontFamily="Bahnschrift, Segoe UI" FontWeight="Bold" FontSize="26" Foreground="White" />
              <TextBlock Text="CLOTH PREVIEW 3D" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Red}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Lista de prendas -->
        <Grid Grid.Row="1" Margin="14,4,14,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Style="{StaticResource RedButton}" Margin="0,14,0,0" Content="ABRIR ARCHIVOS (.ydd / .ytd)" Click="Open_Click" />
          <TextBlock Grid.Row="1" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="…o arrastra una carpeta o los archivos de tu pack a esta ventana." />
          <StackPanel Grid.Row="2">
            <TextBlock Style="{StaticResource SectionTitle}" Text="PRENDAS" />
            <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0" MaxHeight="190"
                     DisplayMemberPath="Display" ItemContainerStyle="{StaticResource RowItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ItemList_SelectionChanged" />
          </StackPanel>
        </Grid>

        <!-- Controles -->
        <StackPanel Grid.Row="2" Margin="14,0,14,14">
          <TextBlock Style="{StaticResource SectionTitle}" Text="TEXTURA" />
          <ListBox x:Name="VariantBox" Background="Transparent" BorderThickness="0" DisplayMemberPath="Label"
                   ItemContainerStyle="{StaticResource ChipItem}" MaxHeight="90"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="VariantBox_SelectionChanged">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>

          <TextBlock Style="{StaticResource SectionTitle}" Text="PERSONAJE" />
          <UniformGrid Columns="3">
            <RadioButton x:Name="GenAuto" Style="{StaticResource Seg}" GroupName="g" Content="AUTO" IsChecked="True" Checked="Gender_Changed" />
            <RadioButton x:Name="GenMale" Style="{StaticResource Seg}" GroupName="g" Content="HOMBRE" Checked="Gender_Changed" />
            <RadioButton x:Name="GenFemale" Style="{StaticResource Seg}" GroupName="g" Content="MUJER" Checked="Gender_Changed" />
          </UniformGrid>

          <TextBlock Style="{StaticResource SectionTitle}" Text="PARTES DE LA PRENDA" />
          <ItemsControl x:Name="PartList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible, Mode=OneWay}"
                          Margin="0,0,14,4" Checked="Part_Toggled" Unchecked="Part_Toggled" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource SectionTitle}" Text="VISTA" />
          <CheckBox x:Name="ShowBody" Content="Mostrar cuerpo" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
          <CheckBox x:Name="ShowTexture" Content="Mostrar textura" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" />
          <CheckBox x:Name="WireBox" Content="Mostrar malla (wireframe)" Checked="Option_Changed" Unchecked="Option_Changed" />
          <CheckBox x:Name="SpinBox" Content="Girar automáticamente" Checked="Spin_Changed" Unchecked="Spin_Changed" />

          <Button x:Name="ImportButton" Style="{StaticResource RedButton}" Margin="0,14,0,0"
                  Content="IMPORTAR CUERPO DESDE GTA V" Click="ImportBody_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== VISOR 3D ===== -->
    <Grid Grid.Column="1">
      <helix:HelixViewport3D x:Name="Viewport" ModelUpDirection="0,0,1" ShowCoordinateSystem="False" ShowViewCube="False">
        <helix:HelixViewport3D.Background>
          <RadialGradientBrush Center="0.5,0.45" RadiusX="0.85" RadiusY="0.85">
            <GradientStop Color="#2A0508" Offset="0" />
            <GradientStop Color="#0C0C0F" Offset="0.65" />
            <GradientStop Color="#050506" Offset="1" />
          </RadialGradientBrush>
        </helix:HelixViewport3D.Background>
        <helix:DefaultLights />
        <ModelVisual3D>
          <ModelVisual3D.Content>
            <Model3DGroup>
              <AmbientLight Color="#383838" />
              <DirectionalLight Color="#8A1218" Direction="1,-1,-0.3" />
              <DirectionalLight Color="#444444" Direction="-1,1,-0.5" />
            </Model3DGroup>
          </ModelVisual3D.Content>
        </ModelVisual3D>
        <ModelVisual3D x:Name="ModelHost" />
        <helix:LinesVisual3D x:Name="Wire" Color="#FF2A2A" Thickness="0.6" />
      </helix:HelixViewport3D>

      <!-- Título de la prenda -->
      <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,6"
              Background="#CC000000" BorderBrush="{StaticResource Red}" BorderThickness="0,0,0,2" CornerRadius="4">
        <TextBlock x:Name="ItemTitle" Text="SIN PRENDA" Foreground="White" FontWeight="Bold"
                   FontFamily="Bahnschrift, Segoe UI" FontSize="15" />
      </Border>

      <!-- Estadísticas -->
      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Padding="12,8"
              Background="#CC000000" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
        <TextBlock x:Name="Info" Foreground="{StaticResource Txt}" FontFamily="Consolas" FontSize="12" />
      </Border>

      <!-- Aviso: cuerpo sin importar -->
      <Border x:Name="BodyOverlay" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="16" Padding="14" MaxWidth="300" Background="#E6000000"
              BorderBrush="{StaticResource Red}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
          <TextBlock Text="PERSONAJE NO IMPORTADO" Foreground="{StaticResource Red}" FontWeight="Bold" />
          <TextBlock Margin="0,6,0,10" Foreground="{StaticResource Txt}" TextWrapping="Wrap" FontSize="12"
                     Text="Para ver la prenda puesta en un hombre o una mujer, importa el cuerpo desde tu GTA V. Se hace una sola vez." />
          <Button Style="{StaticResource RedButton}" Content="IMPORTAR AHORA" Click="ImportBody_Click" />
        </StackPanel>
      </Border>

      <!-- Pista inicial -->
      <TextBlock x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                 Foreground="#55FFFFFF" FontFamily="Bahnschrift, Segoe UI" FontSize="22" IsHitTestVisible="False"
                 Text="ARRASTRA TU PACK AQUÍ&#x0a;.ydd + .ytd" />
    </Grid>
  </Grid>
</Window>
